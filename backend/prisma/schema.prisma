generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  owner
  manager
  cashier
  storekeeper
  accountant
}

model Business {
  id            String          @id @db.Char(36)
  name          String          @db.VarChar(160)
  currency      String          @default("RWF") @db.Char(3)
  address       String?         @db.VarChar(255)
  phone         String?         @db.VarChar(40)
  createdAt     DateTime        @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt     DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamp(0)
  branches      Branch[]
  users         User[]
  loginActivity LoginActivity[]

  @@map("businesses")
}

model Branch {
  id         String   @id @db.Char(36)
  businessId String   @map("business_id") @db.Char(36)
  name       String   @db.VarChar(120)
  address    String?  @db.VarChar(255)
  active     Boolean  @default(true) @db.TinyInt
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamp(0)
  business   Business @relation(fields: [businessId], references: [id])
  users      User[]

  @@unique([businessId, name], map: "uq_branch_name")
  @@index([businessId], map: "ix_branches_business")
  @@map("branches")
}

model User {
  id            String          @id @db.Char(36)
  businessId    String          @map("business_id") @db.Char(36)
  branchId      String?         @map("branch_id") @db.Char(36)
  name          String          @db.VarChar(120)
  email         String          @unique(map: "uq_users_email") @db.VarChar(190)
  passwordHash  String          @map("password_hash") @db.VarChar(100)
  role          UserRole        @default(cashier)
  active        Boolean         @default(true) @db.TinyInt
  createdAt     DateTime        @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt     DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamp(0)
  business      Business        @relation(fields: [businessId], references: [id])
  branch        Branch?         @relation(fields: [branchId], references: [id])
  loginActivity LoginActivity[]

  @@index([businessId, email], map: "ix_users_business_email")
  @@index([branchId], map: "ix_users_branch")
  @@map("users")
}

model LoginActivity {
  id         String   @id @db.Char(36)
  businessId String   @map("business_id") @db.Char(36)
  userId     String?  @map("user_id") @db.Char(36)
  successful Boolean  @db.TinyInt
  ipAddress  String?  @map("ip_address") @db.VarChar(45)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamp(0)
  business   Business @relation(fields: [businessId], references: [id])
  user       User?    @relation(fields: [userId], references: [id])

  @@index([businessId, userId, createdAt], map: "ix_login_user_time")
  @@map("login_activity")
}

model BssbmsMigrationHistory {
  version     String    @id @db.VarChar(32)
  status      String    @db.VarChar(8)
  startedAt   DateTime  @default(now()) @map("started_at") @db.Timestamp(0)
  completedAt DateTime? @map("completed_at") @db.Timestamp(0)

  @@map("bssbms_migration_history")
}
